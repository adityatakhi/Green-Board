generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { STUDENT TEACHER ADMIN SUPER_ADMIN }
enum PublishState { DRAFT PUBLISHED ARCHIVED }
enum ResourceType { NOTES NCERT PYQ QUESTION_BANK FORMULA_SHEET VIDEO ARTICLE STUDY_GUIDE OTHER }
enum QuestionType { MCQ TRUE_FALSE NUMERICAL SUBJECTIVE }
model User { id String @id @default(cuid()) name String email String @unique phone String? passwordHash String? profileImage String? classId Int? role Role @default(STUDENT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt enrollments Enrollment[] progress Progress[] saved SavedResource[] attempts TestAttempt[] orders Order[] }
model Class { id Int @id name String @unique subjects Subject[] resources Resource[] }
model Subject { id String @id @default(cuid()) name String classId Int class Class @relation(fields:[classId],references:[id],onDelete:Restrict) chapters Chapter[] resources Resource[] @@unique([name,classId]) @@index([classId]) }
model Chapter { id String @id @default(cuid()) name String slug String subjectId String subject Subject @relation(fields:[subjectId],references:[id],onDelete:Restrict) resources Resource[] @@unique([subjectId,slug]) }
model Resource { id String @id @default(cuid()) title String slug String @unique description String? type ResourceType classId Int subjectId String chapterId String? thumbnailUrl String? fileUrl String? videoUrl String? state PublishState @default(DRAFT) seoTitle String? seoDescription String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt class Class @relation(fields:[classId],references:[id]) subject Subject @relation(fields:[subjectId],references:[id]) chapter Chapter? @relation(fields:[chapterId],references:[id]) saved SavedResource[] @@index([classId,subjectId,chapterId]) @@index([state]) }
model QuestionBank { id String @id @default(cuid()) title String questions Question[] }
model Question { id String @id @default(cuid()) text String type QuestionType options Json? correctAnswer Json? explanation String? marks Int @default(1) difficulty String? classId Int subjectId String chapterId String? bankId String? bank QuestionBank? @relation(fields:[bankId],references:[id]) @@index([classId,subjectId,chapterId]) }
model Test { id String @id @default(cuid()) title String slug String @unique durationMin Int questions TestQuestion[] attempts TestAttempt[] published Boolean @default(false) }
model TestQuestion { testId String questionId String order Int test Test @relation(fields:[testId],references:[id],onDelete:Cascade) question Question @relation(fields:[questionId],references:[id]) @@id([testId,questionId]) @@unique([testId,order]) }
model TestAttempt { id String @id @default(cuid()) userId String testId String startedAt DateTime @default(now()) submittedAt DateTime? score Int? total Int? percentage Float? status String @default("IN_PROGRESS") user User @relation(fields:[userId],references:[id]) test Test @relation(fields:[testId],references:[id]) answers TestAnswer[] @@index([userId,testId]) }
model TestAnswer { id String @id @default(cuid()) attemptId String questionId String answer Json? correct Boolean? attempt TestAttempt @relation(fields:[attemptId],references:[id],onDelete:Cascade) @@unique([attemptId,questionId]) }
model Course { id String @id @default(cuid()) title String slug String @unique description String? thumbnailUrl String? instructor String? price Int @default(0) published Boolean @default(false) modules CourseModule[] enrollments Enrollment[] }
model CourseModule { id String @id @default(cuid()) title String order Int courseId String course Course @relation(fields:[courseId],references:[id],onDelete:Cascade) lessons Lesson[] @@unique([courseId,order]) }
model Lesson { id String @id @default(cuid()) title String order Int content String? videoUrl String? moduleId String module CourseModule @relation(fields:[moduleId],references:[id],onDelete:Cascade) progress Progress[] @@unique([moduleId,order]) }
model Enrollment { id String @id @default(cuid()) userId String courseId String status String @default("ACTIVE") enrolledAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) course Course @relation(fields:[courseId],references:[id]) @@unique([userId,courseId]) }
model Progress { id String @id @default(cuid()) userId String lessonId String percent Int @default(0) completed Boolean @default(false) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id]) lesson Lesson @relation(fields:[lessonId],references:[id]) @@unique([userId,lessonId]) }
model SavedResource { id String @id @default(cuid()) userId String resourceId String createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) resource Resource @relation(fields:[resourceId],references:[id],onDelete:Cascade) @@unique([userId,resourceId]) }
model Order { id String @id @default(cuid()) userId String amount Int currency String @default("INR") status String @default("CREATED") providerOrderId String? providerPaymentId String? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) @@unique([providerOrderId]) @@unique([providerPaymentId]) }
model AuditLog { id String @id @default(cuid()) actorId String? action String targetType String targetId String? metadata Json? createdAt DateTime @default(now()) @@index([actorId,createdAt]) }
model SiteSettings { id String @id @default("default") data Json updatedAt DateTime @updatedAt }
